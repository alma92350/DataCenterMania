{
  "name": "datacentermania",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "A top-down data center management game for desktop and mobile browsers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/webxr": "^0.5.24",
    "happy-dom": "^15.11.7",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
